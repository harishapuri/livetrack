{
  "manifest_version": 3,
  "name": "Coact Form Agent",
  "version": "0.1.0",
  "description": "Fills forms on the current tab when Coact desktop sends a queue card SOP.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coact Form Agent",
    "default_popup": "popup.html"
  }
}
