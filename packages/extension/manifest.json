{
  "manifest_version": 3,
  "name": "liveAct Form Agent",
  "version": "0.1.27",
  "description": "Fills forms on the current tab when liveAct desktop sends a queue card SOP.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "windows", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "liveAct Form Agent",
    "default_popup": "popup.html"
  }
}
