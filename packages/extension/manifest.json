{
  "manifest_version": 3,
  "name": "LiveTrack Form Agent",
  "version": "0.1.50",
  "description": "Fills forms on the current tab when LiveTrack desktop sends a queue card SOP.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "windows", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LiveTrack Form Agent",
    "default_popup": "popup.html"
  }
}
