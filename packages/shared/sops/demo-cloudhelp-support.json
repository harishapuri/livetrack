{
  "id": "demo-cloudhelp-support",
  "name": "CloudHelp Desk — Support ticket",
  "description": "Fill the CloudHelp Desk demo form on the current tab.",
  "formUrl": "http://127.0.0.1:4173/sites/cloudhelp-support",
  "steps": [
    {
      "id": "reporter",
      "action": "fill",
      "label": "Your name",
      "selector": "#reporter",
      "valueFrom": "reporter"
    },
    {
      "id": "email",
      "action": "fill",
      "label": "Work email",
      "selector": "#email",
      "valueFrom": "email",
      "mandatory": true
    },
    {
      "id": "product",
      "action": "fill",
      "label": "Product",
      "selector": "#product",
      "valueFrom": "product"
    },
    {
      "id": "severity",
      "action": "fill",
      "label": "Severity",
      "selector": "#severity",
      "valueFrom": "severity"
    },
    {
      "id": "subject",
      "action": "fill",
      "label": "Subject",
      "selector": "#subject",
      "valueFrom": "subject"
    },
    {
      "id": "details",
      "action": "fill",
      "label": "Issue details",
      "selector": "#details",
      "valueFrom": "details"
    },
    {
      "id": "highlight-review",
      "action": "highlight",
      "label": "Highlight submit for human review",
      "selector": "#submitBtn"
    }
  ]
}
