{
  "name": "@coact/liveact",
  "version": "0.1.0",
  "private": true,
  "description": "LiveTrack Electron app — queue cards, step watcher, pause/takeover",
  "author": "LiveTrack",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "generate-day-sql": "node scripts/generate-day-sql.js",
    "pack": "electron-builder --dir --config.electronVersion=33.4.11",
    "dist": "electron-builder --config.electronVersion=33.4.11",
    "dist:mac": "electron-builder --mac --config.electronVersion=33.4.11",
    "dist:win": "electron-builder --win --config.electronVersion=33.4.11",
    "dist:win:uninstaller": "node scripts/build-portable-uninstaller.js"
  },
  "dependencies": {
    "@coact/shared": "*",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.livetrack.app",
    "productName": "LiveTrack",
    "copyright": "Copyright © LiveTrack",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "../../../release"
    },
    "afterPack": "./scripts/after-pack-clear-quarantine.js",
    "files": [
      "**/*",
      "!scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../demo",
        "to": "demo",
        "filter": [
          "**/*",
          "!generate-sites.js",
          "!package.json"
        ]
      },
      {
        "from": "../jira-mock",
        "to": "jira-mock",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prompts",
        "to": "prompts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "LiveTrack captures a screen region for Desk tickets and captures meeting playback (earphones or speakers) for Minutes of Meeting.",
        "NSMicrophoneUsageDescription": "LiveTrack uses the microphone for spoken prompts and Minutes of Meeting, including speaker playback in the room.",
        "NSSpeechRecognitionUsageDescription": "LiveTrack converts spoken prompts into text for Ask LiveTrack."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LiveTrack-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiveTrack",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": null,
      "include": null
    },
    "portable": {
      "artifactName": "LiveTrack-Portable-${version}-${arch}.${ext}"
    }
  }
}
